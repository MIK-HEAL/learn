{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "msvc-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "VCPKG_ROOT": "D:/vcpkg/vcpkg"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "CMake: Build Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "msvc-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "VCPKG_ROOT": "D:/vcpkg/vcpkg"
        }
      },
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
