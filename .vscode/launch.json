{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug window (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc/bin/Debug/window.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "CMake: Build Debug"
    },
    {
      "name": "Release window (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc/bin/Release/window.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "CMake: Build Release"
    }
  ]
}
